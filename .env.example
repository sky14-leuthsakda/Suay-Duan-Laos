# Port for server (defaults to 3000, Render sets this automatically)
PORT=3000

# Backend API URL (Leave blank if frontend and backend are hosted on same domain / VPS / Render)
# Set when frontend is hosted separately on Cloudflare Pages (e.g. https://suay-duan-laos.onrender.com)
VITE_API_URL=

# WebSocket URL (Leave blank if same origin)
# Set when frontend is hosted separately (e.g. wss://suay-duan-laos.onrender.com)
VITE_WS_URL=

# Set to 'true' to force local in-browser simulation mock, or 'false' for live server
VITE_USE_MOCK=false
